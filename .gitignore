# data (copied from capstone2/data) and results are not tracked; anchored to the repo root so the
# legacy_v1/data/ code package is not caught. data/universe (screening lists read by production_config) and data/params (GA rule parameters, save_ga_params.py) are tracked.
/data/*
!/data/universe/
!/data/params/
/results/
__pycache__/
*.pyc
.ipynb_checkpoints/
.vscode/
.idea/
